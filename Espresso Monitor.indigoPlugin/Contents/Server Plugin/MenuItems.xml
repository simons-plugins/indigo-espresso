<?xml version="1.0"?>
<MenuItems>
    <MenuItem id="startBackflushMenu">
        <Name>Start backflush...</Name>
        <ButtonTitle>Start</ButtonTitle>
        <CallbackMethod>startBackflushMenu</CallbackMethod>
        <ConfigUI>
            <Field id="machineId" type="menu">
                <Label>Machine:</Label>
                <List class="indigo.devices" filter="self.espressoMachine"/>
            </Field>
            <Field id="help" type="label" fontSize="small" fontColor="darkgray">
                <Label>Every pump run until 2 minutes after the last one counts as backflush, not shots. Cancels itself after 10 minutes if nothing pumps.</Label>
            </Field>
        </ConfigUI>
    </MenuItem>
    <MenuItem id="markTankRefilledMenu">
        <Name>Mark tank refilled...</Name>
        <ButtonTitle>Refilled</ButtonTitle>
        <CallbackMethod>markTankRefilledMenu</CallbackMethod>
        <ConfigUI>
            <Field id="machineId" type="menu">
                <Label>Machine:</Label>
                <List class="indigo.devices" filter="self.espressoMachine"/>
            </Field>
        </ConfigUI>
    </MenuItem>
</MenuItems>
